{
  "manifest_version": 3,
  "name": "SQLiBar",
  "version": "1.0.9",
  "browser_specific_settings": {
    "gecko": {
      "id": "SQLIBar@bLackn3x",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "cookies"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "devtools_page": "devtools.html",

  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [ "content.js" ]
    }
  ]
}
